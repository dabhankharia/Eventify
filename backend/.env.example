# Eventify Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string

# PostgreSQL Database URL
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventify

# Razorpay Test Mode Gateway (https://dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email Notifications (SMTP Configuration)
# Works with Gmail, SendGrid, Mailgun, Amazon SES, Brevo, or any SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Eventify" <no-reply@eventify.in>

# SMS Notifications (Fast2SMS — Free Indian SMS Gateway)
# Supports fully custom messages on free developer tier. No DLT hassle.
# Sign up free at https://www.fast2sms.com → Dashboard → Dev API → copy your key
# Only works with Indian (+91) mobile numbers
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Admin Seed Endpoint Secret (protects POST /api/admin/seed)
# Set this to any random string. Use it as the ?secret= query param to trigger seeding.
# Example: curl -X POST "https://your-app.onrender.com/api/admin/seed?secret=YOUR_SECRET"
SEED_SECRET=replace_with_your_own_secret_string
